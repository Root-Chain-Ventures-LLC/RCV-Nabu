# Copy to .env and fill in. Never commit .env. Every value below is an example.

# Public URL users type into the browser (scheme, host and port). It decides whether cookies get
# the Secure flag and whether the CSP sends upgrade-insecure-requests/HSTS, and the CSRF guard
# compares each browser request's Origin against it: if it does not match the address people
# actually use, sign-in and setup are refused with "cross-origin request blocked".
# For a local trial over plain http: BASE_URL=http://localhost:8080 together with ALLOW_INSECURE_BASE_URL=true.
BASE_URL=https://nabu.example.com

# In production (the container image) a BASE_URL that is not https:// is REFUSED at startup,
# because session cookies would then go out without the Secure flag and no HSTS. For a local
# trial over plain http or a test box, opt out explicitly. Do NOT set
# this on an internet-facing deployment: set BASE_URL to the https URL instead.
# ALLOW_INSECURE_BASE_URL=true
# Separate switch: plain http to an AI provider, mail server or identity provider on a public address
# (a private address needs only ALLOW_PRIVATE_OUTBOUND). Leave it off unless a trusted server really has no TLS.
# ALLOW_INSECURE_OUTBOUND=true
# ALLOW_INSECURE_HTTP=true is the deprecated alias that turns both switches on; startup warns when it is set.

# --- AI providers (optional; configured in Settings -> AI, nothing is assumed) ---
# Provider URLs are checked before anything is sent: https is required, loopback / link-local / cloud-metadata
# addresses are always refused, redirects are never followed. A model server on your own network (Ollama, vLLM,
# LM Studio) is a private address: allow those destinations explicitly. With ALLOW_PRIVATE_OUTBOUND plain http is
# accepted towards private addresses only; ALLOW_INSECURE_OUTBOUND (above) allows http to any permitted address.
# ALLOW_PRIVATE_OUTBOUND=false

# Optional first-run guard: when set, POST /api/setup (the form that creates the first admin)
# must carry this value (the setup page shows an extra field). Use it on any install reachable
# before you have signed in once. In production with no SETUP_TOKEN and no administrator yet, Nabu
# generates a one-time token at startup and prints it once in the server log (docker compose logs app);
# it is the only secret Nabu ever logs, and it stops working once the first administrator exists.
# SETUP_TOKEN=

# --- Storage (PostgreSQL with pgvector is the only backend) ---------------
# `docker-compose.yml` runs the database itself (service `db`) and builds DATABASE_URL for the app from
# this password; set it and you are done. Use URL-safe characters (letters and digits, e.g.
# `openssl rand -hex 24`): it is placed into a connection URL unescaped.
# Leave it blank here on purpose: compose refuses to start until you set one.
NABU_DB_PASSWORD=
# Host port for the loopback-only database publish (default 5435).
# NABU_DB_PORT=5435

# Installs that do not use docker-compose.yml's `db` service (an external or managed Postgres, which
# must have the `vector` and `pg_trgm` extensions available) set this directly instead. It is for
# NON-compose installs only: docker-compose.yml overrides DATABASE_URL for the app container with one
# built from NABU_DB_PASSWORD, so setting it here has no effect under compose.
# DATABASE_URL=postgres://nabu:password@db.example.com:5432/nabu

# --- Secrets ---------------------------------------------------------------
# 32 random bytes, base64 or 64 hex characters: openssl rand -base64 32
# Encrypts the secrets stored in the settings table (SMTP password, AI provider keys, OIDC client
# secret). Required in production. Losing it makes those stored secrets unreadable: keep a copy.
# To rotate, set the new value here and list the old one in NABU_SECRET_KEY_PREVIOUS.
NABU_SECRET_KEY=
# NABU_SECRET_KEY_FILE=/run/secrets/nabu_secret_key
# NABU_SECRET_KEY_PREVIOUS=

# --- Encryption in transit (all optional; README "Securing a deployment") ----------
# Files on the data volume are always encrypted at rest with keys derived from NABU_SECRET_KEY: nothing to set.
# Back that key up apart from your volume backups; losing it makes the stored files unreadable.
#
# Serve HTTPS from the app itself (PEM files, re-read on SIGHUP or when they change). Mount them read-only,
# for example ./certs:/certs:ro in docker-compose.yml. The container health check follows the scheme automatically.
# TLS_CERT_FILE=/certs/nabu.pem
# TLS_KEY_FILE=/certs/nabu.key
# Require the reverse proxy to present a client certificate this CA signed (mutual TLS). Only /api/health
# answers without one.
# TLS_CLIENT_CA_FILE=/certs/proxy-ca.pem
# A private CA (PEM bundle) trusted, next to the public roots, for AI providers, mail, single sign-on and an
# https renderer. Lets internal services use TLS without ALLOW_INSECURE_OUTBOUND.
# OUTBOUND_CA_FILE=/certs/internal-ca.pem
# Database TLS: add ?sslmode=verify-full to DATABASE_URL (compose: set NABU_DB_URL_PARAMS=?sslmode=verify-full)
# and give the CA that signed the database's certificate. sslmode prefer/allow are refused.
# DATABASE_CA_FILE=/certs/db-ca.pem
# NABU_DB_URL_PARAMS=

# --- Image -------------------------------------------------------------------
# docker-compose.yml only: the image version to run (X.Y.Z, without a leading v). Unset runs the latest
# stable release. Pin it in production and change it deliberately when you upgrade.
# NABU_VERSION=

# --- Network ---------------------------------------------------------------
PORT=8080
# docker-compose.yml only: which host interface and port publish the app (the container itself always
# listens on 8080). The default is 127.0.0.1 (loopback): right for a reverse proxy on the same machine.
# To reach the app directly, or from a proxy on another machine, publish it: NABU_BIND=0.0.0.0
# NABU_BIND=127.0.0.1
# NABU_PORT=8080
# The app container is read-only with all capabilities dropped; these cap its memory and processes.
# NABU_MEM_LIMIT=3g
# NABU_PIDS_LIMIT=256

# Whether to trust X-Forwarded-* headers (client IP, protocol). Default false = ignore them.
# With an https BASE_URL a reverse proxy almost always terminates TLS in front of the app; if
# TRUST_PROXY is then left unset, startup logs a WARNING because the per-IP rate limits (sign-in,
# setup) and the IP in the audit log would see only the proxy's address. Behind a reverse proxy
# set ONE of:
#   TRUST_PROXY=1                        trust exactly 1 proxy hop (a single ingress / load balancer)
#   TRUST_PROXY=203.0.113.0/24,198.51.100.7   trust only these proxy IPs / CIDR ranges
#   TRUST_PROXY=true                     trust every hop (a client that can reach the app
#                                        directly can then spoof its IP; avoid when you can)
# TRUST_PROXY=false

# --- Interactive HTML documents (optional) -------------------------------------
# An administrator can let a space play uploaded HTML documents live (Spaces -> Edit -> Interactive documents).
# They run in an isolated frame with no network access and no access to Nabu. For defence in depth you can serve
# that frame from its OWN hostname, so even a browser sandbox escape lands on an origin that holds no session:
# an https origin (no path) different from BASE_URL, routed by your proxy to this same app. The app then serves
# the frame on that host only and nothing else there. See README "Securing a deployment".
# LIVE_HTML_ORIGIN=https://live.example.com

# --- Sessions ----------------------------------------------------------------
# SESSION_ABSOLUTE_DAYS=7
# SESSION_IDLE_TIMEOUT_HOURS=12
# MAX_SESSIONS_PER_USER=10

# Optional: max Postgres connections for the app (default 10).
# PG_POOL_MAX=10

# --- Parsing, OCR and import ----------------------------------------------
# Optional document renderer (Gotenberg-compatible: LibreOffice behind HTTP). With it, Word/Excel/
# PowerPoint files get a faithful PDF view, and DOC/XLS/PPT/RTF/ODF files can be previewed and
# searched at all. Without it Office files show a built-in sanitized HTML view and the legacy
# formats are stored and downloadable only. The URL is read from here only, never from the UI.
# With compose:  docker compose --profile renderer up -d    and    RENDERER_URL=http://renderer:3000
# RENDERER_URL=
# RENDERER_TIMEOUT_MS=120000
# RENDERER_MAX_MB=100
# The renderer opens untrusted documents; run it WITHOUT internet access. docker-compose.yml puts it on an
# internal-only network shared with the app (`renderer-internal`); elsewhere give it a deny-all egress rule.
#
# Background parsing workers per app instance (default 2). Every parse runs in its own worker thread
# (so a file that exhausts memory fails that one job, not the server). Each OCR run needs roughly
# 300 MB while it recognises a page: raise NABU_MEM_LIMIT before raising this.
# PARSE_CONCURRENCY=2
# V8 heap ceiling of one parse worker in MB (default 768, min 128). Memory outside the heap (buffers,
# image bitmaps, OCR) is not covered: size NABU_MEM_LIMIT for PARSE_CONCURRENCY x (this + ~300) + 512.
# PARSE_WORKER_MAX_HEAP_MB=768
# A parse running longer than this is terminated and retried later (default 600 seconds).
# PARSE_TIMEOUT_SECONDS=600
# OCR inside one parse stops after this long and keeps the text found so far (default 300 seconds).
# OCR_TIME_BUDGET_SECONDS=300
# Heap ceiling of the main thread (docker-compose.yml passes this to NODE_OPTIONS; default 512 MB).
# NABU_NODE_OPTIONS=--max-old-space-size=512
# Images larger than this many megapixels are refused before decoding (default 40).
# MAX_IMAGE_MEGAPIXELS=40
# Extra OCR languages: a directory of <lang>.traineddata files (the image ships English).
# TESSDATA_DIR=
# ZIP import guards: entries per archive (default 500) and total unpacked size (default 1024 MB).
# IMPORT_MAX_ENTRIES=500
# IMPORT_MAX_TOTAL_MB=1024
# Largest single upload in megabytes (default 100). Files are stored under DATA_DIR (/data in the image).
# MAX_UPLOAD_MB=100
# Most file bytes one request may stage in total (default: twice MAX_UPLOAD_MB), so a bulk upload cannot park
# many full-size files at once. Counted as the bytes arrive, so it holds for chunked bodies too.
# MAX_REQUEST_MB=200

# --- Outgoing mail (review requests, decisions, the daily digest) -------------------------------------
# SMTP is configured in the app by an administrator (Settings -> Email, with a "Send test email" button);
# the password is stored encrypted. Two environment values matter here:
#  - BASE_URL (above) must be the address people use: every link in a message is built from it, and
#    nothing is sent while it is unset.
#  - The mail server address is checked before use: loopback and cloud-metadata addresses are always
#    refused, and private-network addresses (a relay on your own network) only when
#    you opt in:
# ALLOW_PRIVATE_OUTBOUND=true
